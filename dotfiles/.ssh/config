Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github_ssh
    ForwardAgent yes

Host pi
    HostName 192.168.0.80
    User root
    IdentityFile ~/.ssh/id_ed25519_pi

Host hostinger
    HostName hostinger
    User root
    IdentityFile ~/.ssh/id_ed25519_hostinger 

Host shared-services ct200
    HostName lxc-shared-services
    User root
    IdentityFile ~/.ssh/id_ed25519_ct200 

Host private lxc-private ct100
    HostName lxc-private
    User root
    IdentityFile ~/.ssh/id_ed25519_ct100

Host monitoring lxc-monitoring ct300
    HostName lxc-private
    User root
    IdentityFile ~/.ssh/id_ed25519_ct300

Host *
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m