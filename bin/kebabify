#!/usr/bin/env python3
"""Rename files and folders to clean kebab-case.

- lowercases, transliterates Polish diacritics (ż→z, ł→l, …)
- strips apostrophes so "it's" → "its", turns everything else non-alphanumeric
  into single hyphens
- truncates the name whole-word-wise once it exceeds a length limit
- preserves the file extension (including double extensions like .tar.gz)
- given a folder, recurses fully and renames the folder itself too
- on a name collision, appends -2, -3, … so nothing is overwritten
- skips dotfiles/dotdirs (names starting with ".")
- skips well-known project files: CLAUDE.md, README.md, HANDOFF.md
"""

import argparse
import os
import re
import sys
import unicodedata

# Polish letters have no Unicode decomposition for ł, so map explicitly.
# Everything else accented is handled by the NFKD fallback below.
POLISH_MAP = str.maketrans({
    "ą": "a", "ć": "c", "ę": "e", "ł": "l", "ń": "n",
    "ó": "o", "ś": "s", "ż": "z", "ź": "z",
})

# Apostrophe-like characters removed entirely so surrounding letters join.
APOSTROPHES = str.maketrans({"'": "", "’": "", "‘": "", "`": ""})

# Multi-part extensions to keep intact (checked longest-match first, lowercased).
DOUBLE_EXTS = (".tar.gz", ".tar.bz2", ".tar.xz", ".tar.zst")

# Filenames left untouched wherever they appear (matched case-insensitively).
IGNORE_NAMES = {"claude.md", "readme.md", "handoff.md"}


def transliterate(s: str) -> str:
    """Fold accented characters down to ASCII."""
    s = s.translate(POLISH_MAP)
    s = unicodedata.normalize("NFKD", s)
    s = "".join(c for c in s if not unicodedata.combining(c))
    return s


def slugify(stem: str) -> str:
    """Normalize a name stem to kebab-case (no truncation)."""
    stem = stem.lower()
    stem = stem.translate(APOSTROPHES)
    stem = transliterate(stem)
    stem = re.sub(r"[^a-z0-9]+", "-", stem)
    return stem.strip("-")


def truncate_words(slug: str, limit: int) -> str:
    """Keep whole words, stopping after the first word that exceeds `limit`."""
    words = [w for w in slug.split("-") if w]
    if not words:
        return ""
    out = words[0]
    for word in words[1:]:
        if len(out) > limit:
            break
        out = f"{out}-{word}"
    return out


def split_ext(name: str):
    """Return (stem, ext) with ext lowercased; double-extension aware.

    Returns (name, "") when there is no extension.
    """
    lower = name.lower()
    for ext in DOUBLE_EXTS:
        if lower.endswith(ext) and len(name) > len(ext):
            return name[: -len(ext)], ext
    root, dot, suffix = name.rpartition(".")
    if dot and root:  # has a real extension (not a leading-dot name)
        return root, "." + suffix.lower()
    return name, ""


def target_name(name: str, limit: int) -> str | None:
    """Compute the kebab-cased basename, or None if it should be skipped."""
    stem, ext = split_ext(name)
    slug = truncate_words(slugify(stem), limit)
    if not slug:
        return None
    return slug + ext


def unique_path(directory: str, name: str) -> str:
    """Return a path in `directory` for `name`, suffixing -2, -3, … on collision."""
    stem, ext = split_ext(name)
    candidate = name
    n = 2
    existing = {e.lower() for e in os.listdir(directory)}
    while candidate.lower() in existing:
        candidate = f"{stem}-{n}{ext}"
        n += 1
    return os.path.join(directory, candidate)


def rename_one(path: str, limit: int, dry_run: bool) -> None:
    """Rename a single file/folder in place (does not recurse)."""
    directory = os.path.dirname(path) or "."
    name = os.path.basename(path)

    if name.startswith("."):
        return  # leave dotfiles/dotdirs alone

    if name.lower() in IGNORE_NAMES:
        return  # leave well-known project files alone

    new_name = target_name(name, limit)
    if new_name is None:
        print(f"skip (empty after normalize): {path}", file=sys.stderr)
        return
    if new_name == name:
        return  # already clean

    dest = unique_path(directory, new_name)
    rel_old = os.path.join(directory, name) if directory != "." else name
    rel_new = dest if directory != "." else os.path.basename(dest)
    print(f"{rel_old} -> {rel_new}")
    if not dry_run:
        os.rename(path, dest)


def process(path: str, limit: int, dry_run: bool, recurse: bool = True) -> None:
    """Rename `path`; if it is a folder, recurse into it first (bottom-up).

    With recurse=False a folder's contents are left alone and only the folder
    itself is renamed.
    """
    if (recurse and os.path.isdir(path)
            and not os.path.basename(path.rstrip("/")).startswith(".")):
        # Walk top-down so hidden directories can be pruned -- a bottom-up walk
        # has already descended into them by the time it yields them, which
        # would let us rename the insides of .git and friends. Collect first,
        # then rename in reverse: that is bottom-up, so children are renamed
        # before their parent and every path stays valid throughout.
        targets = []
        for dirpath, dirnames, filenames in os.walk(path, topdown=True):
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            targets.extend(os.path.join(dirpath, e) for e in filenames + dirnames)
        for entry in reversed(targets):
            rename_one(entry, limit, dry_run)
    rename_one(path, limit, dry_run)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Rename files/folders to kebab-case.",
    )
    parser.add_argument("paths", nargs="+", help="files or folders to rename")
    parser.add_argument(
        "-l", "--limit", type=int, default=20,
        help="truncate the name once a word pushes it past this length (default: 40)",
    )
    parser.add_argument(
        "-n", "--dry-run", action="store_true",
        help="show what would be renamed without changing anything",
    )
    parser.add_argument(
        "-R", "--no-recurse", action="store_true",
        help="for a folder, rename only the folder itself, not its contents",
    )
    args = parser.parse_args()

    status = 0
    for path in args.paths:
        if not os.path.lexists(path):
            print(f"no such path: {path}", file=sys.stderr)
            status = 1
            continue
        # Resolve "." / ".." / trailing slashes to a real basename, otherwise the
        # dotfile guards mistake them for hidden names and silently skip everything.
        # abspath (not realpath) so a symlink is renamed, not its target.
        process(os.path.abspath(path), args.limit, args.dry_run,
                recurse=not args.no_recurse)
    return status


if __name__ == "__main__":
    sys.exit(main())
