#!/usr/bin/env python3
import sys
import subprocess
import json
import re
from youtube_transcript_api import YouTubeTranscriptApi

def extract_video_id(url):
    """Extract video ID from YouTube URL"""
    patterns = [
        r'(?:youtube\.com/watch\?v=|youtu\.be/)([a-zA-Z0-9_-]{11})',
        r'youtube\.com/embed/([a-zA-Z0-9_-]{11})',
    ]
    
    for pattern in patterns:
        match = re.search(pattern, url)
        if match:
            return match.group(1)
    
    return url

def get_video_title(video_id):
    """Fetch video title using yt-dlp"""
    try:
        result = subprocess.run(
            ['yt-dlp', '--dump-json', f'https://www.youtube.com/watch?v={video_id}'],
            capture_output=True,
            text=True,
            check=True
        )
        data = json.loads(result.stdout)
        return data['title']
    except Exception as e:
        print(f"Warning: Could not fetch title, using video ID instead. Error: {e}")
        return video_id

def title_to_filename(title):
    """Convert title to kebab-case filename"""
    # Remove apostrophes and quotes
    title = title.replace("'", "").replace('"', '').replace("'", '').replace('"', '').replace('"', '')
    # Convert to lowercase
    title = title.lower()
    # Replace spaces and special chars with hyphens
    title = re.sub(r'[^\w\s-]', '', title)  # Keep only alphanumeric, spaces, and hyphens
    title = re.sub(r'[-\s]+', '-', title)   # Replace spaces and multiple hyphens with single hyphen
    # Remove leading/trailing hyphens
    title = title.strip('-')
    return f"{title}.txt"

def main():
    if len(sys.argv) < 2:
        print("Usage: ./get-transcript.py <youtube_url>")
        sys.exit(1)
    
    url = sys.argv[1]
    video_id = extract_video_id(url)
    
    print(f"Fetching video info for: {video_id}")
    
    # Get video title
    title = get_video_title(video_id)
    print(f"Title: {title}")
    
    filename = title_to_filename(title)
    print(f"Filename: {filename}")
    
    print(f"\nFetching transcript...")
    
    try:
        # Create API instance and fetch transcript
        ytt_api = YouTubeTranscriptApi()
        fetched_transcript = ytt_api.fetch(video_id)
        
        # Extract text from snippets
        full_text = " ".join([snippet.text for snippet in fetched_transcript.snippets])
        
        # Save to file
        with open(filename, 'w', encoding='utf-8') as f:
            f.write(full_text)
        
        print(f"\n✓ Transcript saved to {filename}")
        print(f"  ({len(full_text)} characters)")
        print(f"  Language: {fetched_transcript.language}")
        
    except Exception as e:
        print(f"✗ Error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
