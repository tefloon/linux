#!/usr/bin/env python3
"""ccs - Claude Code projects and sessions.

  ccs [QUERY]      project picker (from ~/claude/projects notes): start a fresh
                   session in the project's folder; a unique QUERY skips the
                   picker. ctrl-o: browse that project's conversations instead
  ccs -c           conversation picker: resume a session (ctrl-n: fresh session
                   in its folder instead)
  ccs -l [N]       list the N most recent sessions (default 30)
  ccs -p PROJECT   conversation picker / list for folders containing PROJECT
  ccs --show ID    print the user prompts of one session (used by preview)
  ccs --rename ID NAME   set a session's name (shown instead of its ai-title)

ID can be any unique prefix of the session id, e.g. the first 8 characters.
"""
import glob, json, os, subprocess, sys
from datetime import datetime

BASE = os.path.expanduser("~/.claude/projects")
HOME = os.path.expanduser("~")
NOTES = os.path.expanduser("~/claude/projects")
HUB = os.path.expanduser("~/claude/hub")


def user_texts(path, meta=None):
    """Yield (timestamp, cwd, text) for each real user prompt in a transcript.
    If `meta` is a dict, fill it with the session's ai-title / agent-name and
    the timestamp of its last message ("last")."""
    with open(path, errors="replace") as f:
        for line in f:
            try:
                j = json.loads(line)
            except ValueError:
                continue
            if meta is not None:
                if j.get("type") in ("ai-title", "agent-name"):
                    meta[j["type"]] = j.get("aiTitle") or j.get("agentName")
                elif j.get("timestamp"):
                    meta["last"] = j["timestamp"]
            if j.get("type") != "user" or j.get("isMeta") or j.get("isSidechain"):
                continue
            c = j.get("message", {}).get("content")
            if isinstance(c, list):
                c = " ".join(p.get("text", "") for p in c if isinstance(p, dict) and p.get("type") == "text")
            if not isinstance(c, str):
                continue
            c = c.strip()
            if not c or c.startswith("<") or c.startswith("[Request interrupted"):
                continue
            yield j.get("timestamp", ""), j.get("cwd"), c


def sessions():
    out = []
    for f in glob.glob(f"{BASE}/*/*.jsonl"):
        cwd, first, n, meta = None, None, 0, {}
        for _, c, text in user_texts(f, meta):
            cwd = cwd or c
            first = first or text
            n += 1
        if not n:
            continue
        out.append({
            "id": os.path.basename(f)[:-6],
            "file": f,
            "cwd": cwd or "?",
            # last message time, not file mtime: title rewrites touch the file
            "mtime": datetime.fromisoformat(meta["last"].replace("Z", "+00:00")).timestamp()
                     if "last" in meta else os.path.getmtime(f),
            "prompts": n,
            "first": meta.get("agent-name") or meta.get("ai-title") or " ".join(first.split()),
        })
    return sorted(out, key=lambda s: s["mtime"], reverse=True)


def fmt(s, width=80):
    when = datetime.fromtimestamp(s["mtime"]).strftime("%Y-%m-%d %H:%M")
    where = s["cwd"].replace(HOME, "~").replace("/mnt/chmury/projects/", "@/")
    return f"{when}  {where:<34.34}  {s['first'][:width]}"


def find(sid):
    """Return the transcript path for a full or unique-prefix session id."""
    fs = glob.glob(f"{BASE}/*/{glob.escape(sid)}*.jsonl")
    if len(fs) != 1:
        sys.exit(f"{len(fs)} sessions match {sid!r}")
    return fs[0]


def rename(sid, name):
    """Append an agent-name record (the record Claude Code keeps for renamed sessions)."""
    f = find(sid)
    with open(f, "rb") as fh:
        fh.seek(-1, os.SEEK_END)
        nl = b"" if fh.read(1) == b"\n" else b"\n"
    rec = {"type": "agent-name", "agentName": name,
           "sessionId": os.path.basename(f)[:-6]}
    with open(f, "ab") as fh:
        fh.write(nl + json.dumps(rec, ensure_ascii=False, separators=(",", ":")).encode() + b"\n")
    print(fmt(next(s for s in sessions() if s["file"] == f)))


def show(sid):
    for f in [find(sid)]:
        for ts, cwd, text in user_texts(f):
            print(f"── {ts[:16].replace('T', ' ')}\n{text[:600]}\n")


def projects():
    """One row per (note, path), most recently logged first. Notes without a
    path get the hub as their folder."""
    out = []
    for f in glob.glob(f"{NOTES}/*.md"):
        if os.path.basename(f) == "INDEX.md":
            continue
        meta, title, last = {}, None, ""
        with open(f) as fh:
            for line in fh:
                if title is None and line.startswith(("paths:", "status:")):
                    k, v = line.split(":", 1)
                    meta[k] = v.strip()
                elif title is None and line.startswith("# "):
                    title = line[2:].strip()
                elif line.startswith("- 20") and not last:
                    last = line[2:12]
        title = title or os.path.basename(f)[:-3]
        paths = [os.path.expanduser(x.strip()) for x in meta.get("paths", "").split(",")]
        paths = [x for x in paths if x.startswith("/")] or [None]
        for path in paths:
            out.append({"note": f, "title": title, "status": meta.get("status", ""),
                        "last": last or "—", "path": path})
    return sorted(out, key=lambda p: p["last"].replace("—", ""), reverse=True)


def fmt_project(p):
    where = (p["path"] or "(hub)").replace(HOME, "~").replace("/mnt/chmury/projects/", "@/")
    return f"{p['last']:<10}  {p['status']:<7}  {p['title'][:42]:<42}  {where}"


def note(path):
    """fzf preview: the note without its frontmatter."""
    text = open(path).read()
    if text.startswith("---"):
        text = text.split("---", 2)[2]
    print(text.strip())


def launch(p):
    if p["path"] is None:
        os.chdir(HUB)
        os.execvp("claude", ["claude", f"Let's work on the project in {p['note']}."])
    if not os.path.isdir(p["path"]):
        sys.exit(f"folder gone: {p['path']}")
    os.chdir(p["path"])
    os.execvp("claude", ["claude"])


def pick_project(query):
    ps = projects()
    if not sys.stdout.isatty():
        for p in ps:
            print(fmt_project(p))
        return
    lines = "\n".join(f"{i}\t{p['path'] or HUB}\t{fmt_project(p)}" for i, p in enumerate(ps))
    r = subprocess.run(
        ["fzf", "--delimiter=\t", "--with-nth=3", "--no-sort", "--layout=reverse",
         "--query", query, "--select-1", "--exit-0",
         "--header", "enter: new session · ctrl-o: past conversations",
         "--bind", f"ctrl-o:become({sys.argv[0]} -p {{2}})",
         "--preview", f"{sys.argv[0]} --note {{1}}", "--preview-window=right,50%,wrap"],
        input=lines, text=True, stdout=subprocess.PIPE)
    if r.returncode == 1 and query:
        sys.exit(f"no project matches {query!r}")
    if r.returncode or not r.stdout.strip():
        return
    launch(ps[int(r.stdout.split("\t")[0])])


def main(argv):
    if argv[:1] == ["--show"]:
        return show(argv[1])
    if argv[:1] == ["--rename"]:
        if len(argv) != 3 or not argv[2].strip():
            sys.exit("usage: ccs --rename ID NAME")
        return rename(argv[1], argv[2].strip())
    if argv[:1] in (["-h"], ["--help"]):
        return print(__doc__)
    if argv[:1] == ["--note"]:
        return note(projects()[int(argv[1])]["note"])
    if argv[:1] not in (["-c"], ["-l"], ["-p"]):
        return pick_project(" ".join(argv))
    if argv[:1] == ["-c"]:
        argv = []
    ss = sessions()
    if argv[:1] == ["-p"]:
        ss = [s for s in ss if argv[1].lower() in s["cwd"].lower()]
        argv = []
    if argv[:1] == ["-l"] or not sys.stdout.isatty():
        n = int(argv[1]) if len(argv) > 1 else 30
        for s in ss[:n]:
            print(fmt(s))
        return
    lines = "\n".join(f"{s['id']}\t{s['cwd']}\t{fmt(s)}" for s in ss)
    r = subprocess.run(
        ["fzf", "--delimiter=\t", "--with-nth=3", "--no-sort", "--layout=reverse",
         "--expect=ctrl-n", "--header", "enter: resume · ctrl-n: new session in its folder",
         "--preview", f"{sys.argv[0]} --show {{1}}", "--preview-window=down,50%,wrap"],
        input=lines, text=True, stdout=subprocess.PIPE)
    if r.returncode or not r.stdout.strip():
        return
    key, row = r.stdout.split("\n", 1)
    sid, cwd = row.split("\t")[:2]
    if not os.path.isdir(cwd):
        sys.exit(f"folder gone: {cwd}")
    os.chdir(cwd)
    os.execvp("claude", ["claude"] if key == "ctrl-n" else ["claude", "--resume", sid])


if __name__ == "__main__":
    main(sys.argv[1:])
