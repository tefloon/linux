#!/bin/bash
set -e
set -o pipefail
# OCR text selection script for Wayland/Hyprland

# Take screenshot of selected area and pipe to tesseract
grim -g "$(slurp)" - | tesseract stdin stdout -l pol+eng | wl-copy

# Optional: Show notification of captured text
if command -v notify-send &> /dev/null; then
    notify-send "OCR" "Text copied to clipboard"
fi