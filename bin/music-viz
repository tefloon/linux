#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["librosa", "matplotlib", "numpy", "scipy", "pyloudnorm", "soundfile"]
# ///
"""Turn a piece of music into pictures + a text report an LLM can "listen" to.

Usage: music-viz <audio file> [-o OUTDIR] [--no-separate | --melody-from STEM]

Writes to OUTDIR (default ./<name>-viz/):
  overview.png  time-aligned panels: waveform, loudness, mel spectrogram,
                chroma (harmony), melody pitch, onsets/beats, brightness, stereo width,
                with structural segments shaded across all of them
  spectrum.png  long-term average spectrum (tonal balance), whole track + per section
  ssm.png       self-similarity matrix (repetition / form)
  report.md     numbers: duration, tempo, key, loudness, sections, chords,
                melody notes per section
  stems/        vocals.wav + accompaniment.wav from demucs (reused on reruns)

Leading/trailing silence is trimmed before analysis; times stay those of the file.
By default demucs splits off the vocal (first run downloads ~2 GB of PyTorch via
uvx; then ~40 s per song on CPU). The melody is a pYIN pitch track of that vocal,
chords/key come from the accompaniment. --no-separate tracks the melody on the mix,
which only works when the lead is much louder than the accompaniment.
Decoding goes through ffmpeg, so any format ffmpeg reads works.
"""

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

import librosa
import librosa.display
import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pyloudnorm
import soundfile
from matplotlib.ticker import FuncFormatter, MultipleLocator
from scipy.cluster.hierarchy import fcluster, linkage

SR = 44100
HOP = 1024
MEL_SR, MEL_HOP = 22050, 512  # melody tracking runs at a lower rate (pYIN is slow)
NOTES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]
# Krumhansl-Kessler key profiles
MAJOR = np.array([6.35, 2.23, 3.48, 2.33, 4.38, 4.09, 2.52, 5.19, 2.39, 3.66, 2.29, 2.88])
MINOR = np.array([6.33, 2.68, 3.52, 5.38, 2.60, 3.53, 2.54, 4.75, 3.98, 2.69, 3.34, 3.17])
SEG_COLORS = plt.cm.tab10.colors
DEMUCS = ["uvx", "--python", "3.12", "--with", "soundfile", "--from", "demucs", "demucs",
          "-n", "htdemucs", "--two-stems", "vocals"]


def mmss(t, _pos=None):
    return f"{int(t // 60)}:{int(t % 60):02d}"


def decode(path):
    """Stereo float32 at SR via ffmpeg -> array of shape (2, n)."""
    cmd = ["ffmpeg", "-v", "error", "-i", str(path), "-f", "f32le", "-ac", "2", "-ar", str(SR), "-"]
    raw = subprocess.run(cmd, capture_output=True, check=True).stdout
    return np.frombuffer(raw, dtype=np.float32).reshape(-1, 2).T.copy()


def separate(stereo, stem_dir):
    """Split the (trimmed) track into vocals + accompaniment with demucs; cached in stem_dir."""
    voc, acc = stem_dir / "vocals.wav", stem_dir / "accompaniment.wav"
    if not (voc.exists() and acc.exists()):
        stem_dir.mkdir(parents=True, exist_ok=True)
        src = stem_dir / "input.wav"
        soundfile.write(src, stereo.T, SR)
        print("separating vocals with demucs ...", file=sys.stderr)
        cmd = DEMUCS + ["-o", str(stem_dir), str(src)]
        # model weights come from the Hugging Face Hub; once cached, don't ask the Hub again
        try:
            subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           env=os.environ | {"HF_HUB_OFFLINE": "1"})
        except subprocess.CalledProcessError:
            print("model not cached yet, downloading ...", file=sys.stderr)
            subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL)
        (stem_dir / "htdemucs" / "input" / "vocals.wav").rename(voc)
        (stem_dir / "htdemucs" / "input" / "no_vocals.wav").rename(acc)
        shutil.rmtree(stem_dir / "htdemucs")
        src.unlink()
    return decode(voc).mean(axis=0), decode(acc).mean(axis=0)


def estimate_key(chroma_mean):
    best = None
    for name, prof in (("major", MAJOR), ("minor", MINOR)):
        for i in range(12):
            r = np.corrcoef(chroma_mean, np.roll(prof, i))[0, 1]
            if best is None or r > best[0]:
                best = (r, f"{NOTES[i]} {name}")
    return best[1], best[0]


def chord_templates():
    names, tmpl = [], []
    for i in range(12):
        for suffix, ivs in (("", (0, 4, 7)), ("m", (0, 3, 7))):
            v = np.zeros(12)
            v[[(i + k) % 12 for k in ivs]] = 1
            names.append(NOTES[i] + suffix)
            tmpl.append(v / np.linalg.norm(v))
    return names, np.array(tmpl)


def estimate_chords(sync_chroma):
    """Triad template match per beat, then Viterbi so chords persist instead of flickering."""
    names, tmpl = chord_templates()
    norm = sync_chroma / (np.linalg.norm(sync_chroma, axis=0, keepdims=True) + 1e-9)
    prob = np.exp(12 * (tmpl @ norm))
    prob /= prob.sum(axis=0, keepdims=True)
    path = librosa.sequence.viterbi_discriminative(prob, librosa.sequence.transition_loop(len(names), 0.9))
    return [names[i] for i in path]


def short_term_lufs(y_stereo, meter, win=3.0, hop=1.0):
    n, w, h = y_stereo.shape[1], int(win * SR), int(hop * SR)
    times, vals = [], []
    for start in range(0, max(n - w, 0) + 1, h):
        seg = y_stereo[:, start : start + w].T
        with np.errstate(divide="ignore"):
            vals.append(meter.integrated_loudness(seg))
        times.append((start + w / 2) / SR)
    return np.array(times), np.array(vals)


def track_melody(y, from_stem):
    """pYIN f0 -> (times, midi with NaN where unvoiced, voiced probability)."""
    y = librosa.resample(y, orig_sr=SR, target_sr=MEL_SR)
    if not from_stem:
        y = librosa.effects.harmonic(y)  # drop drums, they confuse the tracker
    lo, hi = ("C2", "C6") if from_stem else ("C3", "C6")
    f0, voiced, prob = librosa.pyin(y, sr=MEL_SR, hop_length=MEL_HOP, frame_length=2048,
                                    fmin=librosa.note_to_hz(lo), fmax=librosa.note_to_hz(hi))
    midi = np.where(voiced & (prob > 0.5), librosa.hz_to_midi(f0), np.nan)
    return librosa.times_like(f0, sr=MEL_SR, hop_length=MEL_HOP), midi, prob


def melody_notes(times, midi, min_dur=0.12):
    """Run-length the rounded pitch track into (start, note) events."""
    q = np.round(midi)
    notes, start, cur = [], None, np.nan
    for t, n in zip(times, q):
        if not (n == cur or (np.isnan(n) and np.isnan(cur))):
            if start is not None and not np.isnan(cur) and t - start >= min_dur:
                notes.append((start, int(cur)))
            start, cur = t, n
    if start is not None and not np.isnan(cur) and times[-1] - start >= min_dur:
        notes.append((start, int(cur)))
    # merge repeats split by a dropped frame
    merged = [n for i, n in enumerate(notes) if i == 0 or n[1] != notes[i - 1][1]]
    return merged


def segment(features, n_frames, duration):
    k = int(np.clip(duration / 20, 4, 12))
    bounds = librosa.segment.agglomerative(features, k)
    bounds = np.unique(np.concatenate([bounds, [n_frames]]))
    bounds = bounds[bounds < n_frames + 1]
    if bounds[0] != 0:
        bounds = np.concatenate([[0], bounds])
    # label similar sections with the same letter
    means = np.array([features[:, a:b].mean(axis=1) for a, b in zip(bounds[:-1], bounds[1:])])
    if len(means) > 1:
        ids = fcluster(linkage(means, "average", metric="cosine"), t=0.08, criterion="distance")
    else:
        ids = np.array([1])
    letters, mapping = [], {}
    for i in ids:
        mapping.setdefault(i, chr(ord("A") + len(mapping)))
        letters.append(mapping[i])
    return bounds, letters


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("audio", type=Path)
    ap.add_argument("-o", "--outdir", type=Path)
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--no-separate", action="store_true", help="skip demucs; track the melody on the mix")
    g.add_argument("--melody-from", type=Path, metavar="STEM",
                   help="your own vocal/lead stem to track the melody from (same timing as the file)")
    args = ap.parse_args()

    out = args.outdir or Path.cwd() / f"{args.audio.stem}-viz"
    out.mkdir(parents=True, exist_ok=True)
    print(f"decoding {args.audio} ...", file=sys.stderr)
    stereo = decode(args.audio)
    file_dur = stereo.shape[1] / SR
    _, (a, b) = librosa.effects.trim(stereo.mean(axis=0), top_db=60, frame_length=4096, hop_length=1024)
    stereo = stereo[:, a:b]
    T0 = a / SR  # every time axis below is shifted by T0, so times match the original file
    y = stereo.mean(axis=0)
    duration = len(y) / SR
    T1 = T0 + duration
    print(f"{file_dur:.1f}s, music {mmss(T0)}–{mmss(T1)}, analysing ...", file=sys.stderr)

    if args.melody_from:
        vocals, accomp = decode(args.melody_from).mean(axis=0)[a:b], None
    elif args.no_separate:
        vocals, accomp = None, None
    else:
        vocals, accomp = separate(stereo, out / "stems")

    # --- features ---------------------------------------------------------
    S = librosa.feature.melspectrogram(y=y, sr=SR, hop_length=HOP, n_mels=128, fmax=16000)
    S_db = librosa.power_to_db(S, ref=np.max)
    chroma = librosa.feature.chroma_cqt(y=y, sr=SR, hop_length=HOP)
    # harmony without the voice's passing notes, when we have it
    chroma_h = chroma if accomp is None else librosa.feature.chroma_cqt(y=accomp, sr=SR, hop_length=HOP)
    mfcc = librosa.feature.mfcc(S=librosa.power_to_db(S), n_mfcc=13)
    onset_env = librosa.onset.onset_strength(y=y, sr=SR, hop_length=HOP)
    tempo, beats = librosa.beat.beat_track(onset_envelope=onset_env, sr=SR, hop_length=HOP)
    tempo = float(np.atleast_1d(tempo)[0])
    beat_times = librosa.frames_to_time(beats, sr=SR, hop_length=HOP) + T0
    centroid = librosa.feature.spectral_centroid(y=y, sr=SR, hop_length=HOP)[0]
    rms = librosa.feature.rms(y=y, hop_length=HOP)[0]
    rms_db = librosa.amplitude_to_db(rms, ref=1.0)
    n_frames = S.shape[1]
    ft = librosa.frames_to_time(np.arange(n_frames), sr=SR, hop_length=HOP) + T0

    print("tracking melody ...", file=sys.stderr)
    from_stem = vocals is not None
    mel_t, mel_midi, _ = track_melody(vocals if from_stem else y, from_stem)
    mel_t += T0
    notes = melody_notes(mel_t, mel_midi)
    mel_src = (f"the {args.melody_from.name} stem" if args.melody_from else "the demucs vocal stem" if from_stem
               else "the most prominent voice in the mix — may jump between vocal and lead instruments")

    # stereo: L/R correlation and side/mid ratio per frame
    L, R = stereo
    mid, side = (L + R) / 2, (L - R) / 2
    rms_mid = librosa.feature.rms(y=mid, hop_length=HOP)[0]
    rms_side = librosa.feature.rms(y=side, hop_length=HOP)[0]
    width = rms_side / (rms_mid + rms_side + 1e-9)
    corr = float(np.corrcoef(L, R)[0, 1]) if np.std(L) > 0 and np.std(R) > 0 else 1.0

    # loudness
    meter = pyloudnorm.Meter(SR)
    lufs = meter.integrated_loudness(stereo.T)
    st_t, st_lufs = short_term_lufs(stereo, meter)
    st_t += T0
    gated = st_lufs[np.isfinite(st_lufs) & (st_lufs > -70) & (st_lufs > lufs - 20)]
    lra = float(np.percentile(gated, 95) - np.percentile(gated, 10)) if len(gated) else float("nan")
    peak_db = 20 * np.log10(np.max(np.abs(stereo)) + 1e-12)
    rms_total_db = 20 * np.log10(np.sqrt(np.mean(y**2)) + 1e-12)

    # structure
    feats = np.vstack([librosa.util.normalize(chroma, axis=0), librosa.util.normalize(mfcc, axis=1)])
    bounds, letters = segment(feats, n_frames, duration)
    bound_t = librosa.frames_to_time(bounds, sr=SR, hop_length=HOP) + T0
    bound_t[-1] = T1

    # key + chords (beat-synchronous)
    key, key_r = estimate_key(chroma_h.mean(axis=1))
    sync_t = librosa.frames_to_time(librosa.util.fix_frames(beats, x_max=n_frames), sr=SR, hop_length=HOP) + T0
    chords = estimate_chords(librosa.util.sync(chroma_h, beats, aggregate=np.median))

    # --- overview figure --------------------------------------------------
    tick = 5 if duration < 60 else 10 if duration < 180 else 15 if duration < 420 else 30
    fig, axes = plt.subplots(8, 1, figsize=(20, 27), sharex=True,
                             gridspec_kw={"height_ratios": [1.2, 1, 2.2, 1.5, 1.5, 1, 1, 0.8]})
    fig.suptitle(f"{args.audio.name}   ·   {mmss(T1 - T0)}   ·   ~{tempo:.0f} (or {tempo / 2:.0f}) BPM   ·   "
                 f"{key}   ·   {lufs:.1f} LUFS", fontsize=15)

    ax = axes[0]
    step = max(1, len(L) // 20000)
    t_s = np.arange(0, len(L), step) / SR + T0
    ax.plot(t_s, L[::step], lw=0.4, color="tab:blue", alpha=0.7, label="L")
    ax.plot(t_s, -np.abs(R[::step]), lw=0.4, color="tab:orange", alpha=0.7, label="R (mirrored)")
    ax.set_ylim(-1, 1)
    ax.set_ylabel("Waveform")
    ax.legend(loc="upper right", fontsize=8)

    ax = axes[1]
    ax.plot(ft, rms_db, lw=0.6, color="gray", label="RMS dBFS (per frame)")
    ax.plot(st_t, st_lufs, lw=1.5, color="crimson", label="short-term LUFS (3 s)")
    ax.axhline(lufs, ls="--", lw=0.8, color="crimson", alpha=0.6)
    lo = np.nanpercentile(np.where(np.isfinite(rms_db), rms_db, np.nan), 2)
    ax.set_ylim(max(lo - 3, -60), 0)
    ax.set_ylabel("Loudness (dB)")
    ax.legend(loc="lower right", fontsize=8)

    ax = axes[2]
    librosa.display.specshow(S_db, sr=SR, hop_length=HOP, x_coords=ft, x_axis="time", y_axis="mel", fmax=16000,
                             ax=ax, cmap="magma")
    ax.set_ylabel("Mel spectrogram (Hz)")

    ax = axes[3]
    librosa.display.specshow(chroma, sr=SR, hop_length=HOP, x_coords=ft, x_axis="time", y_axis="chroma", ax=ax,
                             cmap="viridis")
    ax.set_ylabel("Chroma (pitch class)")

    ax = axes[4]
    ax.scatter(mel_t, mel_midi, s=1.5, color="tab:red")
    if np.isfinite(mel_midi).any():
        lo, hi = np.nanmin(mel_midi), np.nanmax(mel_midi)
        ax.set_ylim(np.floor(lo) - 2, np.ceil(hi) + 2)
        ax.yaxis.set_major_locator(MultipleLocator(2 if hi - lo < 14 else 4))
        ax.yaxis.set_major_formatter(FuncFormatter(lambda m, _p: librosa.midi_to_note(int(m))))
    ax.grid(axis="y", alpha=0.3)
    ax.set_ylabel("Melody (pitch)" + ("\nfrom vocal stem" if from_stem else "\nfrom mix"))

    ax = axes[5]
    ax.plot(ft[: len(onset_env)], onset_env, lw=0.6, color="black")
    ax.vlines(beat_times, 0, onset_env.max(), color="tab:green", lw=0.4, alpha=0.5)
    ax.set_ylabel("Onsets / beats")

    ax = axes[6]
    ax.plot(ft, centroid, lw=0.6, color="tab:purple")
    ax.set_ylabel("Brightness\n(centroid Hz)")

    ax = axes[7]
    ax.plot(ft, width, lw=0.6, color="tab:cyan")
    ax.set_ylim(0, 0.5)
    ax.set_ylabel("Stereo width\nside/(mid+side)")

    for a_ in axes:
        for i, (t0, t1) in enumerate(zip(bound_t[:-1], bound_t[1:])):
            a_.axvline(t0, color="white" if a_ in axes[2:4] else "k", lw=0.8, ls=":")
            if a_ not in axes[2:4]:
                a_.axvspan(t0, t1, color=SEG_COLORS[(ord(letters[i]) - 65) % 10], alpha=0.08)
        a_.xaxis.set_major_locator(MultipleLocator(tick))
        a_.xaxis.set_major_formatter(FuncFormatter(mmss))
        a_.grid(axis="x", alpha=0.3)
        a_.set_xlabel("")
    for i, (t0, t1) in enumerate(zip(bound_t[:-1], bound_t[1:])):
        axes[0].text((t0 + t1) / 2, 0.92, letters[i], ha="center", va="top", fontsize=12, weight="bold")
    axes[-1].set_xlim(T0, T1)
    axes[-1].set_xlabel("time in the file (m:ss)")
    fig.tight_layout(rect=(0, 0, 1, 0.98))
    fig.savefig(out / "overview.png", dpi=90)
    plt.close(fig)

    # --- long-term average spectrum ---------------------------------------
    n_fft = 8192
    D = np.abs(librosa.stft(y, n_fft=n_fft, hop_length=n_fft // 2)) ** 2
    freqs = librosa.fft_frequencies(sr=SR, n_fft=n_fft)
    d_t = librosa.frames_to_time(np.arange(D.shape[1]), sr=SR, hop_length=n_fft // 2) + T0
    # 1/6-octave smoothing: average power within log-spaced bands
    edges = 20 * 2 ** np.arange(0, np.log2(20000 / 20) + 1 / 6, 1 / 6)
    centers = np.sqrt(edges[:-1] * edges[1:])
    band_idx = [(freqs >= lo_) & (freqs < hi_) for lo_, hi_ in zip(edges[:-1], edges[1:])]

    def smooth(p):
        return np.array([p[m].mean() if m.any() else np.nan for m in band_idx])

    ref = np.nanmax(smooth(D.mean(axis=1)))
    fig, ax = plt.subplots(figsize=(14, 7))
    ax.semilogx(centers, 10 * np.log10(smooth(D.mean(axis=1)) / ref + 1e-12), color="black", lw=2.5, label="whole track")
    for i, (t0, t1) in enumerate(zip(bound_t[:-1], bound_t[1:])):
        m = (d_t >= t0) & (d_t < t1)
        if m.sum():
            ax.semilogx(centers, 10 * np.log10(smooth(D[:, m].mean(axis=1)) / ref + 1e-12), lw=1,
                        color=SEG_COLORS[(ord(letters[i]) - 65) % 10], alpha=0.8,
                        label=f"{letters[i]} {mmss(t0)}–{mmss(t1)}")
    for f, name in ((60, "sub"), (250, "low-mid"), (2000, "presence"), (6000, "brilliance")):
        ax.axvline(f, color="gray", lw=0.5, ls="--")
        ax.text(f * 1.05, -5, name, fontsize=8, color="gray")
    ax.set_xlim(20, 20000)
    ax.set_ylim(-90, 3)
    ax.set_xlabel("Frequency (Hz)")
    ax.set_ylabel("Power (dB, rel. max)")
    ax.set_title("Long-term average spectrum")
    ax.grid(which="both", alpha=0.3)
    ax.legend(fontsize=7, ncol=2)
    fig.tight_layout()
    fig.savefig(out / "spectrum.png", dpi=100)
    plt.close(fig)

    # --- self-similarity --------------------------------------------------
    sync_feats = librosa.util.sync(feats, beats)
    ssm = librosa.segment.recurrence_matrix(sync_feats, mode="affinity", metric="cosine", sym=True)
    bt = sync_t
    fig, ax = plt.subplots(figsize=(10, 10))
    ax.imshow(ssm, origin="lower", cmap="gray_r", extent=[bt[0], bt[-1], bt[0], bt[-1]])
    for t in bound_t[1:-1]:
        ax.axvline(t, color="red", lw=0.6)
        ax.axhline(t, color="red", lw=0.6)
    for ax_ in (ax.xaxis, ax.yaxis):
        ax_.set_major_locator(MultipleLocator(tick * 2))
        ax_.set_major_formatter(FuncFormatter(mmss))
    ax.set_title("Self-similarity (beat-synced chroma+timbre); diagonal stripes = repeats")
    fig.tight_layout()
    fig.savefig(out / "ssm.png", dpi=100)
    plt.close(fig)

    # --- report -----------------------------------------------------------
    def band_db(lo, hi):
        m = (freqs >= lo) & (freqs < hi)
        return 10 * np.log10(D[m].mean(axis=1).sum() / D.mean(axis=1).sum() + 1e-12)

    trimmed = "" if file_dur - duration < 0.5 else (
        f" — music runs {mmss(T0)}–{mmss(T1)} of a {mmss(file_dur)} file; silence outside that was ignored")
    lines = [f"# {args.audio.name}", "",
             f"- Duration: {mmss(duration)} ({duration:.1f} s){trimmed}",
             f"- Tempo (estimate): ~{tempo:.1f} BPM, or ~{tempo / 2:.1f} if that's double time — the beat tracker "
             f"can't tell which one feels like the pulse ({len(beats)} beats at the faster rate)",
             f"- Key (estimate): {key} (profile correlation {key_r:.2f}; <0.6 = ambiguous)",
             f"- Integrated loudness: {lufs:.1f} LUFS · loudness range ~{lra:.1f} LU · "
             f"sample peak {peak_db:.1f} dBFS · crest (peak–RMS) {peak_db - rms_total_db:.1f} dB",
             f"- Stereo: L/R correlation {corr:.2f} (1 = mono, ~0 = very wide, <0 = phase issues) · "
             f"mean width {width.mean():.2f}",
             f"- Mean brightness (spectral centroid): {np.median(centroid):.0f} Hz",
             "- Energy share by band: " + ", ".join(
                 f"{n} {band_db(lo_, hi_):.1f} dB" for n, lo_, hi_ in
                 (("sub <60", 20, 60), ("bass 60–250", 60, 250), ("low-mid 250–2k", 250, 2000),
                  ("presence 2–6k", 2000, 6000), ("air >6k", 6000, 20000))),
             "", "## Sections (automatic; same letter = similar material)", "",
             "| # | Label | Time | Length | Loudness (LUFS) | Centroid (Hz) | Strongest pitch classes |",
             "|---|---|---|---|---|---|---|"]
    for i, (t0, t1) in enumerate(zip(bound_t[:-1], bound_t[1:])):
        m = (ft >= t0) & (ft < t1)
        sm = (st_t >= t0) & (st_t < t1) & np.isfinite(st_lufs)
        loud = f"{np.mean(st_lufs[sm]):.1f}" if sm.any() else "–"
        top = ", ".join(NOTES[j] for j in np.argsort(chroma_h[:, m].mean(axis=1))[::-1][:3])
        lines.append(f"| {i + 1} | {letters[i]} | {mmss(t0)}–{mmss(t1)} | {t1 - t0:.0f} s | {loud} | "
                     f"{np.median(centroid[m]):.0f} | {top} |")
    voiced = np.isfinite(mel_midi)
    lines += ["", f"## Melody (pYIN pitch track of {mel_src})", ""]
    if voiced.any():
        lines.append(f"- Range {librosa.midi_to_note(int(np.round(np.nanmin(mel_midi))))}–"
                     f"{librosa.midi_to_note(int(np.round(np.nanmax(mel_midi))))}, median "
                     f"{librosa.midi_to_note(int(np.round(np.nanmedian(mel_midi))))}, "
                     f"pitched {100 * voiced.mean():.0f}% of the time")
        lines += ["- Notes per section (onset time + note, notes shorter than 0.12 s dropped):", ""]
        for i, (t0, t1) in enumerate(zip(bound_t[:-1], bound_t[1:])):
            sec = [(t, n) for t, n in notes if t0 <= t < t1]
            shown = " ".join(f"{mmss(t)} {librosa.midi_to_note(n)}" for t, n in sec[:80])
            more = f" … (+{len(sec) - 80})" if len(sec) > 80 else ""
            lines.append(f"  - {letters[i]} {mmss(t0)}–{mmss(t1)}: {shown or '(no clear melody)'}{more}")
    else:
        lines.append("- No clear pitched melody detected.")
    chord_src = "accompaniment stem" if accomp is not None else "mix"
    lines += ["", f"## Chords (from the {chord_src}; major/minor triads only, smoothed — a hint, not a transcription)", ""]
    runs, prev, start = [], None, 0.0
    for t, c in zip(sync_t, chords):
        if c != prev:
            if prev is not None:
                runs.append((start, prev))
            prev, start = c, t
    if prev is not None:
        runs.append((start, prev))
    lines.append(" ".join(f"{mmss(t)} {c}" for t, c in runs))
    lines += ["", "## Files", "",
              "- overview.png — time-aligned panels (waveform, loudness, mel spectrogram, chroma, "
              "melody pitch, onsets+beats, brightness, stereo width); shaded bands and letters = sections above",
              "- spectrum.png — average spectrum, whole track and per section (tonal balance, mix)",
              "- ssm.png — self-similarity matrix; off-diagonal stripes show repeated passages"]
    (out / "report.md").write_text("\n".join(lines) + "\n")
    print(out)


if __name__ == "__main__":
    main()
