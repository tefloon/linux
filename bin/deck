#!/usr/bin/env python3
import re
import json
import sys


def parse_deck(filename):
    cards = []

    # Pattern to match card lines: "2x Card Name ●●●●" or "1x Card Name"
    pattern = r"^(\d+)x\s+(.+?)(?:\s+●+)?$"

    with open(filename, "r", encoding="utf-8") as f:
        lines = [line.strip() for line in f]

        # Get the second non-empty line as the ID
        non_empty_lines = [line for line in lines if line.strip()]
        if len(non_empty_lines) >= 2:
            identity = non_empty_lines[1]
            cards.append({"title": identity, "amount": 1})

        # Parse all card lines
        for line in lines:
            match = re.match(pattern, line)
            if match:
                amount = int(match.group(1))
                title = match.group(2).strip()
                cards.append({"title": title, "amount": amount})

    return cards


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: python parse_deck.py <deck_file>")
        sys.exit(1)

    deck_file = sys.argv[1]
    cards = parse_deck(deck_file)

    # Output as formatted JSON
    print(json.dumps(cards, indent=2, ensure_ascii=False))